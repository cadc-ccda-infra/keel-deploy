                    <hard>600</hard>
                </executionDuration>
                <!-- outputLimit for async queries: 128MB -->
                <outputLimit>
                    <default unit="byte">134217728</default>
                    <hard unit="byte">134217728</hard>
                </outputLimit>
                <!-- outputLimit for sync queries: no limit -->
                <uploadLimit>
                    <default unit="row">100000</default>
                    <hard unit="row">100000</hard>
                </uploadLimit>

